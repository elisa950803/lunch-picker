# Google Maps API Key
# Get your key from: https://console.cloud.google.com/
# Required APIs: Places API (New), Directions API (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Calendarific API Key (Optional)
# Get your key from: https://calendarific.com/
# Alternatively, use the date-holidays library which doesn't require an API key
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# Note: Weather API (Open-Meteo) does not require an API key
# See docs/PROVIDERS.md for more information
