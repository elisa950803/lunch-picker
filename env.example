# Google Maps API Key
# Required for Distance Matrix API and Places API
# Get your API key from: https://console.cloud.google.com/
# Enable Distance Matrix API and Places API in the Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Calendarific API Key
# Required for holiday information via Calendarific API
# Get your API key from: https://calendarific.com/
# Alternative: Use date-holidays library (no API key required)
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# Note: Weather API (Open-Meteo) does not require an API key

# Backend API URL (for GitHub Pages deployment)
# Set this to your deployed backend URL (e.g. Render, Fly, Railway, Vercel)
# Example: https://lunch-picker-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=
